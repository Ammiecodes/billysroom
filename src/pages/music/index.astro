---
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import Player from '../../components/Player.astro';
import site from '../../data/site.json';
import { getMixes, getKolanut, getReleases, embedFor, shortDate, typeLabel } from '../../lib/util';
import ReleaseCard from '../../components/ReleaseCard.astro';
const all = await getMixes();
const audio = all.filter((m) => embedFor(m.data.url).kind !== 'youtube');
const video = all.filter((m) => embedFor(m.data.url).kind === 'youtube');
const episodes = await getKolanut();
const releases = await getReleases();
const defaultTab = releases.length ? 'releases' : 'mixes';
---
<Base tone="tobacco" theme="music-page" title="music" current="music" bg={site.sessions_image} description="billysroom music — releases, afro house mixes, live sets and kolanut.fm.">
  <Logo page="sessions" sub="music" tone="page" />

  <div class="tabs" role="tablist" aria-label="music" data-default={defaultTab}>
    {releases.length > 0 && <a class="pill small tab" role="tab" href="#releases" data-tab="releases">releases · {releases.length}</a>}
    <a class="pill small tab" role="tab" href="#mixes" data-tab="mixes">mixes · {audio.length}</a>
    {video.length > 0 && <a class="pill small tab" role="tab" href="#live" data-tab="live">live sets · {video.length}</a>}
    <a class="pill small tab" role="tab" href="#kolanut" data-tab="kolanut">kolanut.fm{episodes.length > 0 && ` · ${episodes.length}`}</a>
  </div>

  {releases.length > 0 && (
    <section id="releases" class="tab-panel" role="tabpanel" aria-label="releases">
      <div class="release-grid">{releases.map((r) => <ReleaseCard release={r} />)}</div>
    </section>
  )}

  <section id="mixes" class="tab-panel" role="tabpanel" aria-label="mixes">
    {audio.map((m) => (
      <article class="session">
        <div>
          <h3 class="h3">{m.data.title}<span class="tag" data-new-until={m.data.date.getTime() + 60 * 86400_000} hidden>new</span></h3>
          <p>dj: billysroom · {shortDate(m.data.date)}</p>
          {m.data.description && <p>{m.data.description}</p>}
        </div>
        <Player url={m.data.url} title={m.data.title} />
      </article>
    ))}
  </section>

  {video.length > 0 && (
    <section id="live" class="tab-panel" role="tabpanel" aria-label="live sets">
      {video.map((m) => (
        <article class="session">
          <div>
            <h3 class="h3">{m.data.title}</h3>
            {m.data.description && <p>{m.data.description}</p>}
          </div>
          <Player url={m.data.url} title={m.data.title} />
        </article>
      ))}
    </section>
  )}

  <section id="kolanut" class="tab-panel kolanut" role="tabpanel" aria-label="kolanut.fm">
    <div class="k-head">
      {site.kolanut_logo ? <h2 style="margin:0"><img class="k-logo" src={site.kolanut_logo} alt="kolanut.fm" /></h2> : <h2 class="k-title">kolanut.fm</h2>}
      <p class="k-intro">{site.kolanut_intro}</p>
      {episodes.length === 0 && <p class="k-soon">coming soon</p>}
      {site.kolanut_instagram && <a class="pill small k-follow" href={site.kolanut_instagram} target="_blank" rel="noopener">follow kolanut.fm for updates ↗</a>}
    </div>
    {episodes.map((e) => (
      <article class="session">
        <div>
          <p class="k-ep">{e.data.episode}</p>
          <h3 class="h3">{e.data.title}</h3>
          <p>{e.data.guest && <>with {e.data.guest} · </>}{shortDate(e.data.date)}</p>
          {e.data.description && <p>{e.data.description}</p>}
        </div>
        <Player url={e.data.url} title={`kolanut.fm ${e.data.episode}: ${e.data.title}`} />
      </article>
    ))}
  </section>

  <p class="sc-more" style="text-align:center;margin-top:28px"><a class="pill small" href={site.soundcloud} target="_blank" rel="noopener">more on soundcloud ↗</a></p>
  <script>
    const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
    const show = (id: string) => {
      if (!tabs.some((t) => t.dataset.tab === id)) id = document.querySelector<HTMLElement>('[data-default]')?.dataset.default || 'mixes';
      tabs.forEach((t) => { const on = t.dataset.tab === id; t.setAttribute('aria-selected', String(on)); t.classList.toggle('on', on); });
      document.querySelectorAll<HTMLElement>('.tab-panel').forEach((p) => (p.hidden = p.id !== id));
      const sc = document.querySelector<HTMLElement>('.sc-more'); if (sc) sc.hidden = id !== 'mixes';
    };
    tabs.forEach((t) => t.addEventListener('click', (e) => { e.preventDefault(); history.replaceState(null, '', '#' + t.dataset.tab); show(t.dataset.tab!); }));
    show(location.hash.slice(1));
    if (location.hash) requestAnimationFrame(() => window.scrollTo(0, 0));
  </script>
</Base>
