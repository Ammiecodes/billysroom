---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Player from '../components/Player.astro';
import Newsletter from '../components/Newsletter.astro';
import site from '../data/site.json';
import ReleaseCard from '../components/ReleaseCard.astro';
import { getGigs, getDrops, getMixes, getReleases, embedFor, endsAt, longDate, shortDate, timeOf } from '../lib/util';
const gigs = await getGigs();
const drops = await getDrops();
const mixes = await getMixes();
const releases = await getReleases();
const latest = mixes.find((m) => embedFor(m.data.url).kind !== 'youtube');
const upcoming = [
  ...gigs.map((g) => ({ date: g.data.date, name: g.data.venue, place: `${g.data.city} ${g.data.country}`, time: g.data.time_label || timeOf(g.data.date), href: g.data.ticket_url || '/dates', cta: g.data.ticket_url ? 'tickets' : 'details', ext: !!g.data.ticket_url })),
  ...drops.map((x) => ({ date: x.data.date, name: `${x.data.title}${x.data.edition ? ' ' + x.data.edition : ''}`, place: x.data.city, time: x.data.doors || timeOf(x.data.date), href: '/exclusive', cta: 'invite', ext: false })),
].sort((a, b) => a.date.getTime() - b.date.getTime());
---
<Base tone="deep" current="home" bg={site.hero_image}>
  <section class="hero">
    <Logo page="home"><span class="sr"> — {site.tagline}</span></Logo>

    <div class="hero-actions">

    <div class="pills">
      <a class="pill" href="/music">listen</a>
      <a class="pill" href="/dates">where to catch me</a>
      <a class="pill solid" href="/press#book">book me</a>
    </div>
    </div>

    <a class="scroll-cue" href="#more" aria-label="scroll for more">↓</a>
  </section>

  <div class="below" id="more" style={site.home_sections_image ? `background-image:url(${site.home_sections_image})` : undefined}>
    {releases.length > 0 && (
      <section class="home-sec" data-section>
        <h2 class="kicker">new music</h2>
        <div data-next data-list="home-rel" data-hide-when-empty>
          {releases.map((r) => (
            <div data-ends={r.data.release_date.getTime() + 60 * 86400000} data-when="upcoming"><ReleaseCard release={r} compact /></div>
          ))}
        </div>
        <p class="more"><a href="/music#releases">all releases →</a></p>
      </section>
    )}
    {latest && (
      <section class="home-sec">
        <h2 class="kicker">latest mix</h2>
        <h3 class="h3">{latest.data.title}</h3>
        {latest.data.description && <p class="meta" style="margin-bottom:12px">{latest.data.description}</p>}
        <Player url={latest.data.url} title={latest.data.title} />
        <p class="more"><a href="/music#mixes">all mixes →</a> <a href="/music#live">live sets →</a></p>
      </section>
    )}

    <section class="home-sec">
      <h2 class="kicker">where to catch me</h2>
      <ul class="clean agenda" data-list="home-up">
        {upcoming.map((u) => (
          <li data-ends={endsAt(u.date)} data-when="upcoming">
            <span class="ag-date">{shortDate(u.date)}</span>
            <span class="ag-what">{u.name}<small>{u.place} · {u.time}</small></span>
            <a class="pill small" href={u.href} target={u.ext ? '_blank' : undefined} rel="noopener">{u.cta}</a>
          </li>
        ))}
      </ul>
      <p class="meta" data-empty="home-up" hidden>no public dates right now — roommates hear about new ones first.</p>
      <p class="more"><a href="/dates">all dates →</a></p>
    </section>

    <section class="home-sec">
      <h2 class="kicker">billy’s room</h2>
      <div data-next>
        {[...drops].sort((a, b) => a.data.date.getTime() - b.data.date.getTime()).map((x) => (
          <a class="br-card" href="/exclusive" data-ends={endsAt(x.data.date)} data-when="upcoming">
            {x.data.flyer && <img src={x.data.flyer} alt="" loading="lazy" />}
            <span><b>next: {x.data.title}{x.data.edition ? ' ' + x.data.edition : ''}</b>{longDate(x.data.date)} · {x.data.city}<em>get an invite →</em></span>
          </a>
        ))}
      </div>
      <div data-last>
        {drops.map((x) => (
          <a class="br-card" href="/exclusive" data-ends={endsAt(x.data.date)} data-when="past">
            {x.data.flyer && <img src={x.data.flyer} alt="" loading="lazy" />}
            <span><b>last: {x.data.title}{x.data.edition ? ' ' + x.data.edition : ''}</b>{longDate(x.data.date)} · {x.data.city}{x.data.lineup.length > 0 && <small>{x.data.lineup.join(' · ')}</small>}<em>all past editions →</em></span>
          </a>
        ))}
      </div>
      <p class="lead" style="margin-top:14px">intimate afro house nights, with friends on the decks. invites go to roommates first.</p>
    </section>

    <section class="home-sec">
      <h2 class="kicker">about</h2>
      <p class="lead">{site.bio_short}</p>
      <p class="more"><a href="/press">press kit & booking →</a> <a href={`mailto:${site.demo_email}?subject=demo%20for%20billysroom`}>send demos / tracks →</a></p>
    </section>

    <section class="home-sec" id="roommates">
      <h2 class="kicker">join the roommates</h2>
      <p class="lead">first access to my exclusive parties, tickets to featured events and inside gist.</p>
      <Newsletter id="nl-home" cta="join the roommates 💌" />
    </section>
  </div>
</Base>
