---
import '../styles/global.css';
import site from '../data/site.json';
import Icons from '../components/Icons.astro';
const { title, description = site.tagline, bg = '', theme = '', tone = 'deep', current = '', image = '' } = Astro.props;
const toneHex: Record<string, string> = { deep: '#2e1d6c', earth: '#214732', tobacco: '#6d4f45' };
const fullTitle = title ? `${title} – [billysroom]` : '[billysroom]';
const nav = [
  { href: '/', label: 'dj', key: 'home' },
  { href: '/music', label: 'music', key: 'music' },
  { href: '/dates', label: 'dates', key: 'dates' },
  { href: '/exclusive', label: 'exclusive', key: 'exclusive' },
  { href: '/press', label: 'press', key: 'press' },
];
const ogImage = image || bg || site.hero_image;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="theme-color" content={toneHex[tone] || toneHex.deep} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="[billysroom]" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <slot name="head" />
</head>
<body class={`${theme} tone-${tone}${bg ? ' has-photo' : ''}`}>
  <div class={`backdrop ${bg ? '' : 'placeholder'}`} style={bg ? `background-image:url(${bg})` : ''} aria-hidden="true"></div>
  <nav class="site-nav" aria-label="Main">
    {nav.map((n) => <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>)}
  </nav>
  <main>
    <slot />
  </main>
  <Icons />
  <script>
    // Date-driven content: anything with data-ends flips from "upcoming" to "past"
    // in the visitor's browser, so the site never shows a stale gig, even between deploys.
    const now = Date.now();
    document.querySelectorAll<HTMLElement>('[data-ends]').forEach((el) => {
      const past = Number(el.dataset.ends) <= now;
      const want = el.dataset.when; // "upcoming" | "past"
      el.hidden = want === 'upcoming' ? past : !past;
    });
    document.querySelectorAll<HTMLElement>('[data-new-until]').forEach((el) => (el.hidden = Number(el.dataset.newUntil) <= now));
    // Empty-state messages for lists that ended up with nothing visible
    document.querySelectorAll<HTMLElement>('[data-list]').forEach((list) => {
      const visible = list.querySelectorAll('[data-ends]:not([hidden])').length;
      const empty = document.querySelector<HTMLElement>(`[data-empty="${list.dataset.list}"]`);
      if (empty) empty.hidden = visible > 0;
      if (list.dataset.hideWhenEmpty !== undefined) list.closest<HTMLElement>('[data-section]')!.hidden = visible === 0;
    });
    // exclusive page: lead with the upcoming party, or with past editions when nothing is coming
    document.querySelectorAll<HTMLElement>('[data-drop-flow]').forEach((flow) => {
      const has = !!flow.querySelector('[data-list="drops"] [data-ends]:not([hidden])');
      flow.dataset.drop = has ? 'yes' : 'no';
      flow.querySelectorAll<HTMLElement>('[data-if-drop]').forEach((el) => (el.hidden = el.dataset.ifDrop !== flow.dataset.drop));
    });
    // "next up" picks the first upcoming entry
    document.querySelectorAll<HTMLElement>('[data-next]').forEach((box) => {
      const first = box.querySelector<HTMLElement>('[data-ends]:not([hidden])');
      box.querySelectorAll<HTMLElement>('[data-ends]').forEach((el) => (el.hidden = el !== first));
      box.hidden = !first;
    });
    // "last" shows only the most recent past entry, and only when nothing is coming up
    document.querySelectorAll<HTMLElement>('[data-last]').forEach((box) => {
      const first = box.querySelector<HTMLElement>('[data-ends]:not([hidden])');
      box.querySelectorAll<HTMLElement>('[data-ends]').forEach((el) => (el.hidden = el !== first));
      const sib = box.previousElementSibling as HTMLElement | null;
      box.hidden = !first || !!(sib && sib.hasAttribute('data-next') && !sib.hidden);
    });
    // release badges: "out 12.11.26" before, "out now" for 60 days after, then the date
    document.querySelectorAll<HTMLElement>('[data-release-at]').forEach((el) => {
      const at = Number(el.dataset.releaseAt);
      if (now < at) el.textContent = el.dataset.pre || el.textContent;
      else if (now < at + 60 * 86400000) el.textContent = el.dataset.out || el.textContent;
    });
    // menu: clear at the top, page colour once scrolled
    const navEl = document.querySelector<HTMLElement>('.site-nav');
    const onScroll = () => navEl?.classList.toggle('scrolled', window.scrollY > 8);
    onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
    // YouTube: load the real player only when tapped (keeps pages fast)
    document.querySelectorAll<HTMLButtonElement>('button[data-yt]').forEach((b) => {
      b.addEventListener('click', () => {
        const f = document.createElement('iframe');
        f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1`;
        f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        f.title = b.getAttribute('aria-label') || 'YouTube video';
        b.replaceChildren(f);
        b.style.cursor = 'default';
      }, { once: true });
    });
  </script>
</body>
</html>
